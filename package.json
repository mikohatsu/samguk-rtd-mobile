{
  "name": "sangoku-random-defense",
  "version": "0.2.20",
  "private": true,
  "description": "Sangoku Random Defense mobile app (Capacitor)",
  "scripts": {
    "ui": "node scripts/build-ui.js",
    "build": "node scripts/build-ui.js && node scripts/build-www.js",
    "sync": "npm run build && npx cap sync ios",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "server": "node server/app.js"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/screen-orientation": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-social-login": "^8.7.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
